# Copy this file to .env for local development. Keep real values in .env or
# deployment secrets; never commit credentials.

MONGO_URI=your_mongodb_connection_string
JWT_SECRET=replace_with_a_long_random_secret
PORT=5000
CLIENT_ORIGIN=http://localhost:5500,http://127.0.0.1:5500
ADMIN_SECRET=replace_with_a_long_random_secret

# Zoom Server-to-Server OAuth app with permission to create meetings.
ZOOM_ACCOUNT_ID=your_zoom_account_id
ZOOM_CLIENT_ID=your_zoom_client_id
ZOOM_CLIENT_SECRET=your_zoom_client_secret

# Google Meet via Calendar API (used for Google Meet bookings).
GOOGLE_SERVICE_ACCOUNT_FILE=your_service_account_credentials.json
GOOGLE_CALENDAR_ID=your_google_calendar_id

# Email delivery: configure SMTP or use the Gmail fallback below.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Abrehot Online Tutorials <no-reply@example.com>"

# Optional Gmail fallback (used when SMTP_HOST is empty).
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Required for admin notifications; optional for customer confirmation emails.
ADMIN_EMAIL=

# Base URL used to construct customer links in confirmation emails.
SITE_URL=https://abrehottutoring.com.et
