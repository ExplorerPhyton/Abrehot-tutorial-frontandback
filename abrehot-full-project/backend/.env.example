# Copy this file to .env and fill in your real values. Never commit .env.

# MongoDB Atlas connection string (Atlas > Connect > Drivers)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/abrehot?retryWrites=true&w=majority

# Any long random string. You can generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string

# Port the API server runs on
PORT=5000

# Comma-separated list of origins allowed to call this API.
# If you're opening the HTML files directly (file://) or serving them from
# a simple static server, http://localhost:5500 / http://127.0.0.1:5500 are
# common Live Server ports — adjust to whatever you actually use.
CLIENT_ORIGIN=http://localhost:5500,http://127.0.0.1:5500

# Secret used to protect the admin approval page (admin.html).
# Pick any password-like string — this is NOT your MongoDB password.
ADMIN_SECRET=change_this_to_something_only_you_know

# --- Email notifications (optional) ---
# If these three are left blank, the backend just skips sending emails —
# everything else still works fine without them.
#
# GMAIL_USER / GMAIL_APP_PASSWORD: the Gmail account that SENDS the emails.
# This must be an "App Password", not your normal Gmail password — Google
# blocks regular password login for apps. To create one:
#   1. Turn on 2-Step Verification on that Google account (myaccount.google.com/security)
#   2. Go to myaccount.google.com/apppasswords
#   3. Create an app password (name it anything, e.g. "Abrehot Backend")
#   4. Paste the 16-character code it gives you below (no spaces)
GMAIL_USER=youraccount@gmail.com
GMAIL_APP_PASSWORD=your16charapppassword

# ADMIN_EMAIL: where notifications get sent — can be the same address as
# GMAIL_USER, or a different inbox you actually check.
ADMIN_EMAIL=youraccount@gmail.com
